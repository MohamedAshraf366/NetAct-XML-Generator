{
  "name": "netact-xml-generator",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node --expose-gc node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "node --expose-gc node_modules/next/dist/bin/next start -H 0.0.0.0 -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "verify": "tsx scripts/verify.ts",
    "bench": "tsx --expose-gc scripts/bench.ts",
    "test:fetch": "tsx scripts/test-fetch.ts",
    "test:mdb": "tsx scripts/test-mdb.ts",
    "test:filebuffer": "tsx scripts/test-filebuffer.ts",
    "test:big": "tsx scripts/test-big.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "mdb-reader": "3.2.0",
    "next": "^16.4.1",
    "node-unrar-js": "^2.0.2",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yazl": "^3.3.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
